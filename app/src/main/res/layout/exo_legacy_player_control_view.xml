<?xml version="1.0" encoding="utf-8"?>
<!--
  Tellomi（tellomi/tellomi#1257，owner 2026-09-25「多个视频点开时完全参考 Telegram 的设计」）：
  上面是深色胶囊进度条（左已播、右总时长），中间是本组缩略条，下面一行是 转发 · [倍速] · 删除。播放 / 暂停在屏幕中间（MediaPreviewCenterControlsView）。
  上游的 分享 挪到了右上角「···」里。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:animateLayoutChanges="true"
    android:background="@color/transparent"
    android:layoutDirection="ltr"
    android:orientation="vertical"
    tools:targetApi="28">

    <LinearLayout
        android:id="@+id/exo_duration_viewgroup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/media_preview_pill_background"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/exo_position_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/core_white"
            android:textSize="13sp"
            tools:text="0:02" />

        <androidx.media3.ui.DefaultTimeBar
            android:id="@+id/exo_progress"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_weight="1"
            app:bar_height="6dp"
            app:buffered_color="#66FFFFFF"
            app:played_color="@color/core_white"
            app:scrubber_color="@color/core_white"
            app:scrubber_disabled_size="0dp"
            app:scrubber_dragged_size="14dp"
            app:scrubber_enabled_size="0dp"
            app:touch_target_height="44dp"
            app:unplayed_color="#4DFFFFFF" />

        <TextView
            android:id="@+id/exo_duration_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFeatureSettings="tnum"
            android:includeFontPadding="false"
            android:textColor="@color/core_white"
            android:textSize="13sp"
            tools:text="0:07" />

    </LinearLayout>

    <!-- Tellomi（#1257，owner 2026-09-25）：本组缩略条 + k / N（照 Telegram 在进度条下面、按钮上面），随「轻点」和四角按钮一起显隐；只有一张时 GONE。 -->
    <org.thoughtcrime.securesms.mediapreview.mediarail.AlbumScrubberView
        android:id="@+id/media_preview_album_scrubber"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp"
        android:visibility="gone"
        tools:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/media_preview_bottom_bar_vertical_outer_margin"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/exo_forward"
            android:layout_width="@dimen/exo_media_preview_button_width"
            android:layout_height="@dimen/exo_media_preview_button_height"
            android:layout_marginStart="16dp"
            android:background="@drawable/media_preview_round_button_background"
            android:contentDescription="@string/conversation_selection__menu_forward"
            app:srcCompat="@drawable/symbol_forward_24"
            app:tint="@color/core_white" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <FrameLayout
            android:id="@+id/media_preview_speed_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageButton
                android:id="@+id/media_preview_speed_button"
                android:layout_width="@dimen/exo_media_preview_button_width"
                android:layout_height="@dimen/exo_media_preview_button_height"
                android:background="@drawable/media_preview_round_button_background"
                android:contentDescription="@string/MediaPreviewFragment__playback_speed"
                app:srcCompat="@drawable/symbol_settings_android_24"
                app:tint="@color/core_white" />

            <TextView
                android:id="@+id/media_preview_speed_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:background="@drawable/media_preview_speed_badge_background"
                android:importantForAccessibility="no"
                android:includeFontPadding="false"
                android:paddingStart="3dp"
                android:paddingTop="1dp"
                android:paddingEnd="3dp"
                android:paddingBottom="1dp"
                android:textColor="#FF202022"
                android:textSize="9sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="1.5x"
                tools:visibility="visible" />
        </FrameLayout>

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1.0" />

        <ImageButton
            android:id="@+id/media_preview_delete_button"
            android:layout_width="@dimen/exo_media_preview_button_width"
            android:layout_height="@dimen/exo_media_preview_button_height"
            android:layout_marginEnd="16dp"
            android:background="@drawable/media_preview_round_button_background"
            android:contentDescription="@string/delete"
            app:srcCompat="@drawable/symbol_trash_24"
            app:tint="@color/core_white" />
    </LinearLayout>

</LinearLayout>
