<!-- Tellomi（#1257）：横滑相册。子视图的位置由 AlbumCarouselView.onLayout 按几何摆，这里只给层级。 -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:viewBindingIgnore="true">

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/album_carousel_recycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:overScrollMode="never"
        android:scrollbars="none" />

    <ViewStub
        android:id="@+id/album_carousel_transfer_controls_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout="@layout/transfer_controls_stub" />

    <ViewStub
        android:id="@+id/album_carousel_footer_stub"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout="@layout/album_carousel_footer" />

</merge>
